@@ -0,0 +1,146 @@
+import { Option } from 'effect'
+import { Command, expectNoOutMessage, expectOutMessage, given, message, model, story } from 'foldkit/story'
+import { toParentMessage } from 'foldkit/test'
+import { expect, test } from 'vitest'
+
+import { WorkOrderId } from '../../domain/workOrder'
+import * as PhotosBeforeAfter from './photosBeforeAfter'
+import { Row } from './shared'
+import * as WorkOrderList from './workOrderList'
+import { ListBinding, PhotosBinding, init, update } from './workOrdersPage'
+
+const workOrderId = WorkOrderId.make('wo-1')
+const otherWorkOrderId = WorkOrderId.make('wo-2')
+const row = Row.make({ id: workOrderId, title: 'Leaking sink', amount: 400, approval: 'Waiting' })
+
+const { Message, OutMessage, AttachPhoto, CloseWorkOrder, canClose } = PhotosBeforeAfter
+
+const shownModel = PhotosBeforeAfter.update(PhotosBeforeAfter.init('s').model, Message.RequestedShow({ workOrderId })).model
+
+const withPhotos = (before: ReadonlyArray<string>, after: ReadonlyArray<string>) => ({
+  ...shownModel,
+  before: { ...shownModel.before, urls: before },
+  after: { ...shownModel.after, urls: after },
+})
+
+test('adding a Before photo saves it through AttachPhoto', () => {
+  story(
+    PhotosBeforeAfter.update,
+    given(shownModel),
+    message(Message.UpdatedPhotoDraft({ row: 'Before', value: ' https://img/before-1.jpg ' })),
+    message(Message.ClickedAddPhoto({ row: 'Before' })),
+    model(model => expect(model.before.isSaving).toBe(true)),
+    Command.expectExact(
+      AttachPhoto({
+        target: workOrderId,
+        input: { row: 'Before', url: 'https://img/before-1.jpg' },
+        commandId: 's:PhotosBeforeAfter:0',
+      }),
+    ),
+    Command.resolve(
+      AttachPhoto,
+      Message.SucceededAttachPhoto({ workOrderId, row: 'Before', url: 'https://img/before-1.jpg' }),
+    ),
+    model(model => {
+      expect(model.before).toEqual({ urls: ['https://img/before-1.jpg'], draft: '', isSaving: false })
+      expect(model.after.urls).toEqual([])
+      expect(canClose(model)).toBe(false)
+    }),
+  )
+})
+
+test('an empty draft does not save', () => {
+  story(
+    PhotosBeforeAfter.update,
+    given(shownModel),
+    message(Message.UpdatedPhotoDraft({ row: 'After', value: '   ' })),
+    message(Message.ClickedAddPhoto({ row: 'After' })),
+    Command.expectNone(),
+  )
+})
+
+test('Close is blocked until both rows have a saved photo', () => {
+  story(
+    PhotosBeforeAfter.update,
+    given(withPhotos(['https://img/before-1.jpg'], [])),
+    model(model => expect(canClose(model)).toBe(false)),
+    message(Message.ClickedClose()),
+    Command.expectNone(),
+    model(model => expect(model.closeState).toBe('Open')),
+    message(Message.UpdatedPhotoDraft({ row: 'After', value: 'https://img/after-1.jpg' })),
+    message(Message.ClickedAddPhoto({ row: 'After' })),
+    model(model => expect(canClose(model)).toBe(false)),
+    Command.resolve(AttachPhoto, Message.SucceededAttachPhoto({ workOrderId, row: 'After', url: 'https://img/after-1.jpg' })),
+    model(model => expect(canClose(model)).toBe(true)),
+  )
+})
+
+test('Close saves through CloseWorkOrder and reports the close', () => {
+  story(
+    PhotosBeforeAfter.update,
+    given(withPhotos(['https://img/before-1.jpg'], ['https://img/after-1.jpg'])),
+    message(Message.ClickedClose()),
+    model(model => {
+      expect(model.closeState).toBe('Closing')
+      expect(canClose(model)).toBe(false)
+    }),
+    Command.expectExact(CloseWorkOrder({ target: workOrderId, input: {}, commandId: 's:PhotosBeforeAfter:0' })),
+    Command.resolve(CloseWorkOrder, Message.SucceededCloseWorkOrder({ workOrderId })),
+    expectOutMessage(OutMessage.ClosedWorkOrder({ workOrderId })),
+    model(model => expect(model.closeState).toBe('Closed')),
+  )
+})
+
+test('a refused close shows the reason and allows a retry', () => {
+  story(
+    PhotosBeforeAfter.update,
+    given(withPhotos(['https://img/before-1.jpg'], ['https://img/after-1.jpg'])),
+    message(Message.ClickedClose()),
+    Command.resolve(CloseWorkOrder, Message.FailedCloseWorkOrder({ workOrderId, reason: 'MissingPhotos' })),
+    expectNoOutMessage(),
+    model(model => {
+      expect(model.closeState).toBe('Open')
+      expect(model.maybeError).toEqual(Option.some('MissingPhotos'))
+      expect(canClose(model)).toBe(true)
+    }),
+  )
+})
+
+test('a refused photo keeps the draft and shows the reason', () => {
+  story(
+    PhotosBeforeAfter.update,
+    given(shownModel),
+    message(Message.UpdatedPhotoDraft({ row: 'Before', value: 'https://img/before-1.jpg' })),
+    message(Message.ClickedAddPhoto({ row: 'Before' })),
+    Command.resolve(AttachPhoto, Message.FailedAttachPhoto({ workOrderId, row: 'Before', reason: 'NotOpen' })),
+    model(model => {
+      expect(model.before).toEqual({ urls: [], draft: 'https://img/before-1.jpg', isSaving: false })
+      expect(model.maybeError).toEqual(Option.some('NotOpen'))
+    }),
+  )
+})
+
+test('a photo result for another work order is ignored', () => {
+  story(
+    PhotosBeforeAfter.update,
+    given(shownModel),
+    message(Message.SucceededAttachPhoto({ workOrderId: otherWorkOrderId, row: 'Before', url: 'https://img/x.jpg' })),
+    model(model => expect(model.before.urls).toEqual([])),
+  )
+})
+
+const pageModel = init({ session: 's' }).model
+
+test('selecting a row shows its photos, and a close adds a line', () => {
+  story(
+    update,
+    given({ ...pageModel, list: { ...pageModel.list, rows: [row] } }),
+    message(toParentMessage(ListBinding, WorkOrderList.Message.ClickedRow({ id: row.id }))),
+    model(model => expect(model.photos.maybeWorkOrderId).toEqual(Option.some(workOrderId))),
+    message(toParentMessage(PhotosBinding, Message.SucceededCloseWorkOrder({ workOrderId }))),
+    model(model => {
+      expect(model.photos.closeState).toBe('Closed')
+      expect(model.conversation.lines).toEqual(['Work order closed'])
+    }),
+  )
+})
