new file mode 100644
index 0000000..3390a80
--- /dev/null
+++ b/a-preview/app/photosBeforeAfter.ts
@@ -0,0 +1,251 @@
+import { Array, Effect, Layer, Option, Schema, String } from 'effect'
+import { Block } from 'foldkit'
+import { defineMessageUnion } from 'foldkit/message'
+
+import {
+  AttachPhotoArgs,
+  Client,
+  CloseWorkOrderArgs,
+  CommandIds,
+  execute,
+  nextCommandId,
+} from '../../domain/domainCommands'
+import { PhotoRow, WorkOrderId } from '../../domain/workOrder'
+
+const RowModel = Schema.Struct({
+  urls: Schema.Array(Schema.String),
+  draft: Schema.String,
+  isSaving: Schema.Boolean,
+})
+type RowModel = typeof RowModel.Type
+
+const Model = Schema.Struct({
+  maybeWorkOrderId: Schema.Option(WorkOrderId),
+  before: RowModel,
+  after: RowModel,
+  closeState: Schema.Literals(['Open', 'Closing', 'Closed']),
+  maybeError: Schema.Option(Schema.String),
+  commandIds: CommandIds,
+})
+export type Model = typeof Model.Type
+
+export const Message = defineMessageUnion({
+  RequestedShow: { workOrderId: WorkOrderId },
+  UpdatedPhotoDraft: { row: PhotoRow, value: Schema.String },
+  ClickedAddPhoto: { row: PhotoRow },
+  SucceededAttachPhoto: { workOrderId: WorkOrderId, row: PhotoRow, url: Schema.String },
+  FailedAttachPhoto: { workOrderId: WorkOrderId, row: PhotoRow, reason: Schema.String },
+  ClickedClose: {},
+  SucceededCloseWorkOrder: { workOrderId: WorkOrderId },
+  FailedCloseWorkOrder: { workOrderId: WorkOrderId, reason: Schema.String },
+})
+
+export const OutMessage = defineMessageUnion({ ClosedWorkOrder: { workOrderId: WorkOrderId } })
+
+const PhotosBeforeAfterDefinition = Block.makeDefinition('PhotosBeforeAfter', { Model, Message, OutMessage })
+
+const failureReason = (failure: Readonly<{ _tag: 'Rejected'; rejection: { _tag: string } }> | Readonly<{ _tag: 'Unknown' }>) =>
+  failure._tag === 'Rejected' ? failure.rejection._tag : 'Unknown'
+
+export const AttachPhoto = PhotosBeforeAfterDefinition.makeCommand('AttachPhoto', {
+  args: AttachPhotoArgs,
+  messages: [Message.SucceededAttachPhoto, Message.FailedAttachPhoto],
+  handler: function* () {
+    const client = yield* Client
+    return args =>
+      execute.AttachPhoto(args).pipe(
+        Effect.map(result =>
+          result._tag === 'SucceededAttachPhoto'
+            ? Message.SucceededAttachPhoto({ workOrderId: args.target, row: args.input.row, url: args.input.url })
+            : Message.FailedAttachPhoto({
+                workOrderId: args.target,
+                row: args.input.row,
+                reason: failureReason(result.failure),
+              }),
+        ),
+        Effect.provideService(Client, client),
+      )
+  },
+})
+
+export const CloseWorkOrder = PhotosBeforeAfterDefinition.makeCommand('CloseWorkOrder', {
+  args: CloseWorkOrderArgs,
+  messages: [Message.SucceededCloseWorkOrder, Message.FailedCloseWorkOrder],
+  handler: function* () {
+    const client = yield* Client
+    return args =>
+      execute.CloseWorkOrder(args).pipe(
+        Effect.map(result =>
+          result._tag === 'SucceededCloseWorkOrder'
+            ? Message.SucceededCloseWorkOrder({ workOrderId: args.target })
+            : Message.FailedCloseWorkOrder({ workOrderId: args.target, reason: failureReason(result.failure) }),
+        ),
+        Effect.provideService(Client, client),
+      )
+  },
+})
+
+const emptyRow: RowModel = { urls: [], draft: '', isSaving: false }
+
+const readRow = (model: Model, row: PhotoRow): RowModel => (row === 'Before' ? model.before : model.after)
+
+const writeRow = (model: Model, row: PhotoRow, nextRow: RowModel): Model =>
+  row === 'Before' ? { ...model, before: nextRow } : { ...model, after: nextRow }
+
+const isCurrent = (model: Model, workOrderId: WorkOrderId) => Option.contains(model.maybeWorkOrderId, workOrderId)
+
+export const canClose = (model: Model) =>
+  Option.isSome(model.maybeWorkOrderId) &&
+  model.closeState === 'Open' &&
+  Array.isReadonlyArrayNonEmpty(model.before.urls) &&
+  Array.isReadonlyArrayNonEmpty(model.after.urls)
+
+const PhotosBeforeAfterComposition = PhotosBeforeAfterDefinition.makeComposition()
+
+export const init = PhotosBeforeAfterComposition.makeInit((session: string) => ({
+  model: {
+    maybeWorkOrderId: Option.none(),
+    before: emptyRow,
+    after: emptyRow,
+    closeState: 'Open' as const,
+    maybeError: Option.none(),
+    commandIds: CommandIds.make({ session: `${session}:PhotosBeforeAfter`, sent: 0 }),
+  },
+}))
+
+export const update = PhotosBeforeAfterComposition.makeUpdate({
+  RequestedShow: (model, { workOrderId }) =>
+    isCurrent(model, workOrderId)
+      ? { model }
+      : {
+          model: {
+            ...model,
+            maybeWorkOrderId: Option.some(workOrderId),
+            before: emptyRow,
+            after: emptyRow,
+            closeState: 'Open' as const,
+            maybeError: Option.none(),
+          },
+        },
+  UpdatedPhotoDraft: (model, { row, value }) => ({
+    model: writeRow(model, row, { ...readRow(model, row), draft: value }),
+  }),
+  ClickedAddPhoto: (model, { row }) => {
+    const rowModel = readRow(model, row)
+    const url = rowModel.draft.trim()
+
+    if (Option.isNone(model.maybeWorkOrderId) || String.isEmpty(url) || rowModel.isSaving || model.closeState !== 'Open') {
+      return { model }
+    }
+
+    const allocation = nextCommandId(model.commandIds)
+    return {
+      model: { ...writeRow(model, row, { ...rowModel, isSaving: true }), commandIds: allocation.commandIds },
+      commands: [
+        AttachPhoto({
+          target: model.maybeWorkOrderId.value,
+          input: { row, url },
+          commandId: allocation.commandId,
+        }),
+      ],
+    }
+  },
+  SucceededAttachPhoto: (model, { workOrderId, row, url }) => {
+    if (!isCurrent(model, workOrderId)) {
+      return { model }
+    }
+
+    const rowModel = readRow(model, row)
+    return {
+      model: {
+        ...writeRow(model, row, { urls: Array.append(rowModel.urls, url), draft: '', isSaving: false }),
+        maybeError: Option.none(),
+      },
+    }
+  },
+  FailedAttachPhoto: (model, { workOrderId, row, reason }) => {
+    if (!isCurrent(model, workOrderId)) {
+      return { model }
+    }
+
+    return {
+      model: { ...writeRow(model, row, { ...readRow(model, row), isSaving: false }), maybeError: Option.some(reason) },
+    }
+  },
+  ClickedClose: model => {
+    if (!canClose(model) || Option.isNone(model.maybeWorkOrderId)) {
+      return { model }
+    }
+
+    const allocation = nextCommandId(model.commandIds)
+    return {
+      model: { ...model, closeState: 'Closing' as const, commandIds: allocation.commandIds },
+      commands: [CloseWorkOrder({ target: model.maybeWorkOrderId.value, input: {}, commandId: allocation.commandId })],
+    }
+  },
+  SucceededCloseWorkOrder: (model, { workOrderId }) =>
+    isCurrent(model, workOrderId)
+      ? {
+          model: { ...model, closeState: 'Closed' as const, maybeError: Option.none() },
+          outMessage: OutMessage.ClosedWorkOrder({ workOrderId }),
+        }
+      : { model },
+  FailedCloseWorkOrder: (model, { workOrderId, reason }) =>
+    isCurrent(model, workOrderId)
+      ? { model: { ...model, closeState: 'Open' as const, maybeError: Option.some(reason) } }
+      : { model },
+})
+
+const view = PhotosBeforeAfterComposition.makeView((model, h) => {
+  const rowView = (row: PhotoRow) => {
+    const rowModel = readRow(model, row)
+    return h.div(
+      [h.Class('photo-row'), h.DataAttribute('row', row)],
+      [
+        h.h3([], [row]),
+        h.ul(
+          [],
+          Array.map(rowModel.urls, url => h.li([], [url])),
+        ),
+        h.input([
+          h.Value(rowModel.draft),
+          h.Disabled(model.closeState !== 'Open'),
+          h.OnInput(value => Message.UpdatedPhotoDraft({ row, value })),
+        ]),
+        h.button(
+          [
+            h.Disabled(rowModel.isSaving || model.closeState !== 'Open' || String.isEmpty(rowModel.draft.trim())),
+            h.OnClick(Message.ClickedAddPhoto({ row })),
+          ],
+          [`Add ${row} photo`],
+        ),
+      ],
+    )
+  }
+
+  return h.section(
+    [h.Class('photos-before-after')],
+    Option.match(model.maybeWorkOrderId, {
+      onNone: () => [h.p([], ['Select a work order'])],
+      onSome: () => [
+        rowView('Before'),
+        rowView('After'),
+        h.button([h.Disabled(!canClose(model)), h.OnClick(Message.ClickedClose())], [
+          model.closeState === 'Closed' ? 'Closed' : 'Close',
+        ]),
+        ...Option.toArray(Option.map(model.maybeError, reason => h.p([h.Class('error')], [reason]))),
+      ],
+    }),
+  )
+})
+
+const prepare = () =>
+  PhotosBeforeAfterComposition.prepareBlock({
+    init,
+    update,
+    view,
+    EffectsLayer: Layer.mergeAll(AttachPhoto.layer, CloseWorkOrder.layer),
+    operations: { requestShow: Message.RequestedShow },
+  })
+export const PhotosBeforeAfterBlock: Block.FromAssemblyWithViewAndOutMessage<typeof Model, typeof prepare> =
+  Block.assemble(prepare)
