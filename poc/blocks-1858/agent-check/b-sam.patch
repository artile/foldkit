+
+const typeInto = (container: HTMLElement, row: string, value: string) => {
+  const input = container.querySelector<HTMLInputElement>(`.photos-before-after [data-row="${row}"] input`)
+  if (input === null) {
+    throw new Error(`No ${row} input in ${container.innerHTML}`)
+  }
+  input.value = value
+  input.dispatchEvent(new Event('input'))
+}
+
+const closeButton = (container: HTMLElement) => container.querySelector('.photos-before-after button.close')
+
+it.live('saves before and after photos and closes a work order through the InMemory Domain', () =>
+  Effect.gen(function* () {
+    const container = document.createElement('div')
+    yield* Runtime.run(WorkOrdersPage, {
+      container,
+      layer: BlocksLayer.pipe(Layer.provide(ClientInMemory)),
+      args: { session: 'page' },
+    })
+
+    clickButton(container, 'New work order')
+    yield* waitFor(() => container.textContent?.includes('Leaking sink · Waiting') ?? false)
+    clickButton(container, 'Leaking sink')
+    yield* waitFor(() => closeButton(container) !== null)
+    expect(closeButton(container)?.hasAttribute('disabled')).toBe(true)
+
+    typeInto(container, 'Before', 'https://x/before.jpg')
+    clickButton(container, 'Add Before photo')
+    yield* waitFor(() => container.textContent?.includes('Before (1)') ?? false)
+    expect(closeButton(container)?.hasAttribute('disabled')).toBe(true)
+
+    typeInto(container, 'After', 'https://x/after.jpg')
+    clickButton(container, 'Add After photo')
+    yield* waitFor(() => container.textContent?.includes('After (1)') ?? false)
+    expect(closeButton(container)?.hasAttribute('disabled')).toBe(false)
+
+    clickButton(container, 'Close')
+    yield* waitFor(() => container.textContent?.includes('Work order closed') ?? false)
+    expect(closeButton(container)?.hasAttribute('disabled')).toBe(true)
+  }).pipe(Effect.scoped),
+)
