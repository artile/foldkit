+++ b/b-sam/app/photosBeforeAfter.test.ts
@@ -0,0 +1,129 @@
+import { expect, it } from '@effect/vitest'
+import { Effect, Layer, Option } from 'effect'
+
+import { ClientInMemory } from '../../domain/inMemory'
+import { WorkOrderId } from '../../domain/workOrder'
+import { Block } from '../blocks'
+import { Command, expectNoOutMessage, expectOutMessage, given, message, model, story } from '../blocks/story'
+import { ApprovalPanelLive } from './approvalPanel'
+import { ConversationLive } from './conversation'
+import { LiveTickerLive } from './liveTicker'
+import { AttachPhoto, canClose, CloseWorkOrder, PhotosBeforeAfter, PhotosBeforeAfterLive } from './photosBeforeAfter'
+import { Row } from './shared'
+import { WorkOrderList, WorkOrderListLive } from './workOrderList'
+import { WorkOrdersPageLive } from './workOrdersPage'
+
+const workOrderId = WorkOrderId.make('wo-1')
+
+const PageLayer = WorkOrdersPageLive.pipe(
+  Layer.provide([WorkOrderListLive, ConversationLive, ApprovalPanelLive, LiveTickerLive, PhotosBeforeAfterLive]),
+)
+
+it.effect('adding a photo returns an AttachPhoto Command and shows the saved photo', () =>
+  story(
+    PhotosBeforeAfterLive,
+    { session: 's' },
+    message(PhotosBeforeAfter.Message.RequestedShow({ workOrderId })),
+    message(PhotosBeforeAfter.Message.UpdatedDraft({ row: 'Before', value: ' https://x/before.jpg ' })),
+    message(PhotosBeforeAfter.Message.ClickedAddPhoto({ row: 'Before' })),
+    Command.expectExact([
+      AttachPhoto({
+        target: workOrderId,
+        input: { row: 'Before', url: 'https://x/before.jpg' },
+        commandId: 's:PhotosBeforeAfter:0',
+      }),
+    ]),
+    model(model => {
+      expect(model.beforeDraft).toBe('')
+      expect(model.beforePhotos).toEqual([])
+    }),
+    Command.resolve(AttachPhoto, PhotosBeforeAfter.Message.SucceededAttachPhoto({ row: 'Before', url: 'https://x/before.jpg' })),
+    model(model => {
+      expect(model.beforePhotos).toEqual(['https://x/before.jpg'])
+      expect(model.afterPhotos).toEqual([])
+    }),
+  ).pipe(Effect.provide(ClientInMemory)),
+)
+
+it.effect('an empty draft returns no Command', () =>
+  story(
+    PhotosBeforeAfterLive,
+    { session: 's' },
+    message(PhotosBeforeAfter.Message.RequestedShow({ workOrderId })),
+    message(PhotosBeforeAfter.Message.UpdatedDraft({ row: 'After', value: '   ' })),
+    message(PhotosBeforeAfter.Message.ClickedAddPhoto({ row: 'After' })),
+    Command.expectNone(),
+  ).pipe(Effect.provide(ClientInMemory)),
+)
+
+it.effect('Close is blocked until both rows have a saved photo', () =>
+  story(
+    PhotosBeforeAfterLive,
+    { session: 's' },
+    given({ maybeWorkOrderId: Option.some(workOrderId), beforePhotos: ['https://x/before.jpg'] }),
+    model(model => expect(canClose(model)).toBe(false)),
+    message(PhotosBeforeAfter.Message.ClickedClose()),
+    Command.expectNone(),
+    model(model => expect(model.closeStatus).toBe('Open')),
+    given({ afterPhotos: ['https://x/after.jpg'] }),
+    model(model => expect(canClose(model)).toBe(true)),
+  ).pipe(Effect.provide(ClientInMemory)),
+)
+
+it.effect('Close returns a CloseWorkOrder Command and reports the close', () =>
+  story(
+    PhotosBeforeAfterLive,
+    { session: 's' },
+    given({
+      maybeWorkOrderId: Option.some(workOrderId),
+      beforePhotos: ['https://x/before.jpg'],
+      afterPhotos: ['https://x/after.jpg'],
+    }),
+    message(PhotosBeforeAfter.Message.ClickedClose()),
+    Command.expectExact([CloseWorkOrder({ target: workOrderId, input: {}, commandId: 's:PhotosBeforeAfter:0' })]),
+    expectNoOutMessage(),
+    model(model => {
+      expect(model.closeStatus).toBe('Closing')
+      expect(canClose(model)).toBe(false)
+    }),
+    Command.resolve(CloseWorkOrder, PhotosBeforeAfter.Message.SucceededCloseWorkOrder({ workOrderId })),
+    expectOutMessage(PhotosBeforeAfter.OutMessage.ClosedWorkOrder({ workOrderId })),
+    model(model => expect(model.closeStatus).toBe('Closed')),
+  ).pipe(Effect.provide(ClientInMemory)),
+)
+
+it.effect('a refused close shows the reason and allows another try', () =>
+  story(
+    PhotosBeforeAfterLive,
+    { session: 's' },
+    given({
+      maybeWorkOrderId: Option.some(workOrderId),
+      beforePhotos: ['https://x/before.jpg'],
+      afterPhotos: ['https://x/after.jpg'],
+    }),
+    message(PhotosBeforeAfter.Message.ClickedClose()),
+    Command.resolve(CloseWorkOrder, PhotosBeforeAfter.Message.FailedCloseWorkOrder({ reason: 'MissingPhotos' })),
+    model(model => {
+      expect(model.maybeError).toEqual(Option.some('MissingPhotos'))
+      expect(model.closeStatus).toBe('Open')
+      expect(canClose(model)).toBe(true)
+    }),
+  ).pipe(Effect.provide(ClientInMemory)),
+)
+
+it.effect('selecting a work order shows its photo rows, and a close adds a line', () =>
+  story(
+    PageLayer,
+    { session: 's' },
+    given({
+      list: { rows: [Row.make({ id: workOrderId, title: 'Leaking sink', amount: 400, approval: 'Waiting' })] },
+    }),
+    message(Block.deliver(WorkOrderList, 'list', WorkOrderList.Message.ClickedRow({ id: workOrderId }))),
+    model(model => {
+      expect(model.photos.maybeWorkOrderId).toEqual(Option.some(workOrderId))
+      expect(model.photos.beforePhotos).toEqual([])
+    }),
+    message(Block.deliver(PhotosBeforeAfter, 'photos', PhotosBeforeAfter.Message.SucceededCloseWorkOrder({ workOrderId }))),
+    model(model => expect(model.conversation.lines).toEqual(['Work order closed'])),
+  ).pipe(Effect.provide(ClientInMemory)),
+)
diff --git a/b-sam/app/photosBeforeAfter.ts b/b-sam/app/photosBeforeAfter.ts
new file mode 100644
index 0000000..4f68827
--- /dev/null
+++ b/b-sam/app/photosBeforeAfter.ts
@@ -0,0 +1,203 @@
+import { Array, Effect, Option, Schema, String } from 'effect'
+import { defineMessageUnion } from 'foldkit/message'
+import { modifyFields } from 'foldkit/struct'
+
+import { AttachPhotoArgs, Client, CloseWorkOrderArgs, CommandIds, execute, nextCommandId } from '../../domain/domainCommands'
+import { PhotoRow, WorkOrderId } from '../../domain/workOrder'
+import { Block, Command } from '../blocks'
+
+const Message = defineMessageUnion({
+  RequestedShow: { workOrderId: WorkOrderId },
+  UpdatedDraft: { row: PhotoRow, value: Schema.String },
+  ClickedAddPhoto: { row: PhotoRow },
+  SucceededAttachPhoto: { row: PhotoRow, url: Schema.String },
+  FailedAttachPhoto: { reason: Schema.String },
+  ClickedClose: {},
+  SucceededCloseWorkOrder: { workOrderId: WorkOrderId },
+  FailedCloseWorkOrder: { reason: Schema.String },
+})
+
+export const AttachPhoto = Command.make('AttachPhoto', {
+  args: AttachPhotoArgs,
+  messages: [Message.SucceededAttachPhoto, Message.FailedAttachPhoto],
+})
+
+export const CloseWorkOrder = Command.make('CloseWorkOrder', {
+  args: CloseWorkOrderArgs,
+  messages: [Message.SucceededCloseWorkOrder, Message.FailedCloseWorkOrder],
+})
+
+const CloseStatus = Schema.Literals(['Open', 'Closing', 'Closed'])
+
+const Model = Schema.Struct({
+  maybeWorkOrderId: Schema.Option(WorkOrderId),
+  beforePhotos: Schema.Array(Schema.String),
+  afterPhotos: Schema.Array(Schema.String),
+  beforeDraft: Schema.String,
+  afterDraft: Schema.String,
+  closeStatus: CloseStatus,
+  maybeError: Schema.Option(Schema.String),
+  commandIds: CommandIds,
+})
+type Model = typeof Model.Type
+
+export class PhotosBeforeAfter extends Block<PhotosBeforeAfter, { readonly session: string }>()('PhotosBeforeAfter', {
+  Model,
+  Message,
+  OutMessage: defineMessageUnion({ ClosedWorkOrder: { workOrderId: WorkOrderId } }),
+  Command: [AttachPhoto, CloseWorkOrder],
+}) {}
+
+const photosOf = (model: Model, row: PhotoRow): ReadonlyArray<string> =>
+  row === 'Before' ? model.beforePhotos : model.afterPhotos
+
+const draftOf = (model: Model, row: PhotoRow): string => (row === 'Before' ? model.beforeDraft : model.afterDraft)
+
+const withDraft = (model: Model, row: PhotoRow, value: string): Model =>
+  row === 'Before'
+    ? modifyFields(model, { beforeDraft: () => value })
+    : modifyFields(model, { afterDraft: () => value })
+
+const withPhoto = (model: Model, row: PhotoRow, url: string): Model =>
+  row === 'Before'
+    ? modifyFields(model, { beforePhotos: Array.append(url) })
+    : modifyFields(model, { afterPhotos: Array.append(url) })
+
+export const canClose = (model: Model): boolean =>
+  Option.isSome(model.maybeWorkOrderId) &&
+  model.closeStatus === 'Open' &&
+  Array.isReadonlyArrayNonEmpty(model.beforePhotos) &&
+  Array.isReadonlyArrayNonEmpty(model.afterPhotos)
+
+const ROWS: ReadonlyArray<PhotoRow> = ['Before', 'After']
+
+const reasonOf = (failure: { readonly _tag: 'Rejected'; readonly rejection: { readonly _tag: string } } | { readonly _tag: 'Unknown' }) =>
+  failure._tag === 'Rejected' ? failure.rejection._tag : 'Unknown'
+
+export const PhotosBeforeAfterLive = PhotosBeforeAfter.make(
+  Effect.fn(function* (id, { session }) {
+    const client = yield* Client
+
+    return {
+      model: {
+        maybeWorkOrderId: Option.none(),
+        beforePhotos: [],
+        afterPhotos: [],
+        beforeDraft: '',
+        afterDraft: '',
+        closeStatus: 'Open',
+        maybeError: Option.none(),
+        commandIds: CommandIds.make({ session: `${session}:${id}`, sent: 0 }),
+      },
+      update: {
+        RequestedShow: (model, { workOrderId }) =>
+          Option.contains(model.maybeWorkOrderId, workOrderId)
+            ? { model }
+            : {
+                model: modifyFields(model, {
+                  maybeWorkOrderId: () => Option.some(workOrderId),
+                  beforePhotos: () => [],
+                  afterPhotos: () => [],
+                  beforeDraft: () => '',
+                  afterDraft: () => '',
+                  closeStatus: () => 'Open' as const,
+                  maybeError: () => Option.none(),
+                }),
+              },
+        UpdatedDraft: (model, { row, value }) => ({ model: withDraft(model, row, value) }),
+        ClickedAddPhoto: (model, { row }) => {
+          const url = draftOf(model, row).trim()
+          if (Option.isNone(model.maybeWorkOrderId) || String.isEmpty(url) || model.closeStatus !== 'Open') {
+            return { model }
+          }
+          const allocation = nextCommandId(model.commandIds)
+          return {
+            model: modifyFields(withDraft(model, row, ''), {
+              commandIds: () => allocation.commandIds,
+              maybeError: () => Option.none(),
+            }),
+            commands: [
+              AttachPhoto({ target: model.maybeWorkOrderId.value, input: { row, url }, commandId: allocation.commandId }),
+            ],
+          }
+        },
+        SucceededAttachPhoto: (model, { row, url }) => ({ model: withPhoto(model, row, url) }),
+        FailedAttachPhoto: (model, { reason }) => ({
+          model: modifyFields(model, { maybeError: () => Option.some(reason) }),
+        }),
+        ClickedClose: model => {
+          if (!canClose(model) || Option.isNone(model.maybeWorkOrderId)) {
+            return { model }
+          }
+          const allocation = nextCommandId(model.commandIds)
+          return {
+            model: modifyFields(model, {
+              closeStatus: () => 'Closing' as const,
+              commandIds: () => allocation.commandIds,
+              maybeError: () => Option.none(),
+            }),
+            commands: [CloseWorkOrder({ target: model.maybeWorkOrderId.value, input: {}, commandId: allocation.commandId })],
+          }
+        },
+        SucceededCloseWorkOrder: (model, { workOrderId }) => ({
+          model: modifyFields(model, { closeStatus: () => 'Closed' as const }),
+          outMessage: PhotosBeforeAfter.OutMessage.ClosedWorkOrder({ workOrderId }),
+        }),
+        FailedCloseWorkOrder: (model, { reason }) => ({
+          model: modifyFields(model, { closeStatus: () => 'Open' as const, maybeError: () => Option.some(reason) }),
+        }),
+      },
+      commands: {
+        AttachPhoto: args =>
+          execute.AttachPhoto(args).pipe(
+            Effect.map(result =>
+              result._tag === 'SucceededAttachPhoto'
+                ? PhotosBeforeAfter.Message.SucceededAttachPhoto({ row: args.input.row, url: args.input.url })
+                : PhotosBeforeAfter.Message.FailedAttachPhoto({ reason: reasonOf(result.failure) }),
+            ),
+            Effect.provideService(Client, client),
+          ),
+        CloseWorkOrder: args =>
+          execute.CloseWorkOrder(args).pipe(
+            Effect.map(result =>
+              result._tag === 'SucceededCloseWorkOrder'
+                ? PhotosBeforeAfter.Message.SucceededCloseWorkOrder({ workOrderId: args.target })
+                : PhotosBeforeAfter.Message.FailedCloseWorkOrder({ reason: reasonOf(result.failure) }),
+            ),
+            Effect.provideService(Client, client),
+          ),
+      },
+      view: (model, h) =>
+        h.section(
+          [h.Class('photos-before-after')],
+          Option.match(model.maybeWorkOrderId, {
+            onNone: () => [h.p([], ['Select a work order'])],
+            onSome: () => [
+              ...Array.map(ROWS, row =>
+                h.keyed('div')(row, [h.Class('photo-row'), h.Data('row', row)], [
+                  h.p([], [`${row} (${photosOf(model, row).length})`]),
+                  h.ul([], Array.map(photosOf(model, row), url => h.li([], [url]))),
+                  h.input([
+                    h.Value(draftOf(model, row)),
+                    h.OnInput(value => PhotosBeforeAfter.Message.UpdatedDraft({ row, value })),
+                  ]),
+                  h.button(
+                    [
+                      h.Disabled(model.closeStatus !== 'Open' || String.isEmpty(draftOf(model, row).trim())),
+                      h.OnClick(PhotosBeforeAfter.Message.ClickedAddPhoto({ row })),
+                    ],
+                    [`Add ${row} photo`],
+                  ),
+                ]),
+              ),
+              h.button(
+                [h.Class('close'), h.Disabled(!canClose(model)), h.OnClick(PhotosBeforeAfter.Message.ClickedClose())],
+                [model.closeStatus === 'Closed' ? 'Closed' : 'Close'],
+              ),
+              ...Option.toArray(Option.map(model.maybeError, reason => h.p([h.Class('error')], [reason]))),
+            ],
+          }),
+        ),
+    }
+  }),
+)
