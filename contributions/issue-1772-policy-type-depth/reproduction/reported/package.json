{
  "name": "foldkit-blocks-policy-repro",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate.mjs",
    "typecheck:control": "tsc -p tsconfig.control.json",
    "typecheck:repro": "tsc -p tsconfig.repro.json",
    "runtime:control": "bun src/control.ts",
    "runtime:repro": "bun src/repro.ts",
    "verify": "bun scripts/verify.mjs",
    "lint": "oxlint src scripts && oxfmt --check .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "effect": "4.0.0",
    "foldkit": "0.169.0-canary.1f6776fa7ece"
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.1.0-beta"
  },
  "packageManager": "bun@1.3.14"
}

